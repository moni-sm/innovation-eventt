# Server Configuration
PORT=5000
APP_URL=https://innovation-event.onrender.com # Or your production URL

# Database
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/solidworks_innovation?retryWrites=true&w=majority

# ==============================================================================
# EMAIL DELIVERY OPTIONS
# ==============================================================================
# NOTE FOR RENDER: Render blocks outbound SMTP traffic on ports 25, 465, and 587.
# Direct Gmail SMTP will NOT work on Render (times out with ETIMEDOUT).
# Use Option 1 (Brevo) or Option 2 (Resend) when deploying to Render.
# ==============================================================================

# OPTION 1: Brevo HTTP API (RECOMMENDED for Render - No domain verification needed)
# 1. Sign up for free at https://www.brevo.com (300 free emails/day to any recipient)
# 2. Add & verify your Gmail address under Senders & IP -> Senders
# 3. Create an API Key under SMTP & API -> API Keys (starts with xkeysib-...)
# BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM="SOLIDWORKS Innovation Day 2026" <monikashivakumar2001@gmail.com>

# OPTION 2: Resend HTTP API (Port 443)
# For testing (Free sandbox mode): Resend only permits sending to your account owner's email:
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# RESEND_TEST_EMAIL=monikasm2019@gmail.com
# RESEND_FROM="SOLIDWORKS Innovation Day 2026" <onboarding@resend.dev>
# For production (sending to all attendees): Verify your domain (e.g. conceptia.in) at resend.com/domains
# RESEND_FROM="SOLIDWORKS Innovation Day 2026" <events@conceptia.in>

# OPTION 3: Local Nodemailer SMTP (Works for local testing on your laptop, but NOT on Render)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=monikashivakumar2001@gmail.com
SMTP_PASS=your-16-char-gmail-app-password
EMAIL_FROM="SOLIDWORKS Innovation Day 2026" <monikashivakumar2001@gmail.com>
